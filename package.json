{
  "name": "wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun --watch run src/main.ts",
    "typecheck": "tsc --noEmit",
    "migration:up": "bun run scripts/migrate.ts up",
    "migration:down": "bun run scripts/migrate.ts down",
    "migration:status": "bun run scripts/migrate.ts status",
    "sqs:setup": "bun run scripts/setup-queues.ts",
    "test": "bun test test/unit",
    "test:integration": "bun test test/integration test/concurrency --timeout 120000",
    "sqs:send": "bun run scripts/send-wager-message.ts",
    "test:all": "bun test test/unit test/integration test/concurrency --timeout 120000",
    "test:load": "bun run test/load/run.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1147.0",
    "@mikro-orm/core": "^7",
    "@mikro-orm/migrations": "^7",
    "@mikro-orm/nestjs": "^7",
    "@mikro-orm/postgresql": "^7",
    "@nestjs/common": "^12",
    "@nestjs/core": "^12",
    "@nestjs/platform-express": "^12",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
